// User-supplied deployed policy, reproduced only for emulator regression tests.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /licenses/{licenseId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSyncAt', 'user_name', 'name']);
      allow create, delete: if request.auth != null;
    }
    match /notifications/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /updates/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /telemetry/{document=**} { allow create, update: if true; allow read, delete: if request.auth != null; }
    match /app_config/{document=**} { allow read, write: if true; }
    match /generators/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /trial_users/{machineId} { allow read, create, update: if true; allow delete: if request.auth != null; }
    match /{document=**} { allow read, write: if request.auth != null; }
    match /app_settings/{document=**} { allow read: if true; allow write: if request.auth != null; }
  }
}
